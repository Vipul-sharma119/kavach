# Copy to .env and fill in. Never commit the real .env.

PORT=3000
ALLOWED_ORIGINS=https://www.kulkavach.in,https://kulkavach.in

# --- Email (any SMTP provider: Zoho, Google Workspace, Brevo, SES, ...) ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ops@kulkavach.in
SMTP_PASS=

MAIL_FROM="Kulkavach Website <ops@kulkavach.in>"
MAIL_TO=ops@kulkavach.in,manager@kulkavach.in
MAIL_TO_CAREERS=careers@kulkavach.in

OPS_PHONE=+91 94250 00000

# --- WhatsApp Cloud API (optional; leave blank to use email alerts only) ---
# Meta Business → WhatsApp → API setup. WA_TEMPLATE must be an APPROVED template.
WA_PHONE_ID=
WA_TOKEN=
WA_TO=919425000000,919425000001
WA_TEMPLATE=new_lead
